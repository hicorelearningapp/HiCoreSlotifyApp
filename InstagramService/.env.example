# ─────────────────────────────────────────────────────────────────────────
# Instagram handler service -- runs on port 8002
# Gitignored. Never commit the real file.
# ─────────────────────────────────────────────────────────────────────────

PORT=8002

# Shared with the Backend API and the bot engine. Unset resolves to
# <repo-root>/appointments.db, which is what you want.
# DATABASE_URL=sqlite:///C:/path/to/HiCoreSlotifyApp/appointments.db

# The origin Meta calls: the webhook, the OAuth callback, /privacy and
# /data-deletion are all served by THIS service. Point your tunnel at 8002 and
# put its URL here. Must match the redirect URI in the Meta dashboard.
PUBLIC_BASE_URL=http://127.0.0.1:8002

# ── Meta app (separate from the WhatsApp app -- different secret) ─────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=slotify_verify_token
INSTAGRAM_SIGNATURE_REQUIRED=true

# Fallback token for a single-account install, before any vendor onboards.
INSTAGRAM_ACCESS_TOKEN=

# ── Token encryption ─────────────────────────────────────────────────────
# Durable state, not a rotatable secret: change it and every stored token
# becomes unreadable and every account must be re-onboarded.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INSTAGRAM_TOKEN_ENCRYPTION_KEY=

# ── Default reply policy (per-account overrides live in PolicyJson) ──────
INSTAGRAM_COMMENT_REPLY_MODE=both
INSTAGRAM_COMMENT_MATCH_MODE=all
INSTAGRAM_COMMENT_KEYWORDS=
INSTAGRAM_REPLY_TO_NESTED_COMMENTS=false
INSTAGRAM_IGNORE_OWN_COMMENTS=true

# ── Handoff ──────────────────────────────────────────────────────────────
INSTAGRAM_HANDOFF_MODE=healthcare
# Fallback only -- a connection's BusinessPhoneNumber wins.
INSTAGRAM_HANDOFF_WA_NUMBER=
INSTAGRAM_HANDOFF_PREFILL_TEXT=Hi

# ── Admin API ────────────────────────────────────────────────────────────
# Required. The connection endpoints stay closed until this is set.
ADMIN_API_KEY=

# ── Legal pages (required by Meta App Review) ────────────────────────────
APP_DISPLAY_NAME=HiCore Instagram Handler
PRIVACY_CONTROLLER_NAME=HiCore
PRIVACY_CONTACT_EMAIL=
