# ── Bot engine (Workflows, port 8001) ────────────────────────────────────
# Shared database with the Backend API. Leave unset to use <repo-root>/appointments.db.
# DATABASE_URL=sqlite:///C:/path/to/HiCoreSlotifyApp/appointments.db

# Public origin of the Backend API.
SERVER_BASE_URL=http://127.0.0.1:8003

# Public origin of THIS app, the bot engine. Meta reaches the webhooks,
# /integrations/instagram/callback, /privacy and /data-deletion here.
#   behind a reverse proxy -> leave unset, it falls back to SERVER_BASE_URL
#   ports exposed directly -> set it (or the ngrok https URL)
# Must match the redirect URI registered in the Meta dashboard.
PUBLIC_BASE_URL=http://127.0.0.1:8001

# ── WhatsApp Cloud API ───────────────────────────────────────────────────
ACCESS_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=
APP_SECRET=
ADMIN_PHONE_NUMBER=

# ── Instagram (separate Meta app from WhatsApp) ──────────────────────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=slotify_verify_token
INSTAGRAM_ACCESS_TOKEN=
# Required before any per-vendor token can be stored:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_HANDOFF_MODE=healthcare
INSTAGRAM_HANDOFF_WA_NUMBER=

# ── Admin ────────────────────────────────────────────────────────────────
ADMIN_API_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Optional: NLU via Groq ───────────────────────────────────────────────
NLU_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Legal pages (Meta App Review) ────────────────────────────────────────
APP_DISPLAY_NAME=HiCore Appointment System
PRIVACY_CONTROLLER_NAME=HiCore
PRIVACY_CONTACT_EMAIL=
